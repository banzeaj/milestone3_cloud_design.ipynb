
# Milestone 3: Cloud Computing Fundamentals Implementation

# 1. Import required libraries
import requests
import json

# 2. Define the cloud service model
service_model = "IaaS"

print("Selected cloud service model:", service_model)


# 3. Create cloud resource configuration
cloud_resources = {
    "cpu_cores": 2,
    "ram_gb": 4,
    "storage_gb": 50,
    "region": "af-south-1"
}

print("\nCloud Resource Configuration:")
print(json.dumps(cloud_resources, indent=4))


# 4. Create a virtual machine deployment function
def deploy_vm():
    """Simulate deployment of a virtual machine."""
    return (
        "Deployment successful! "
        f"CPU: {cloud_resources['cpu_cores']} cores, "
        f"RAM: {cloud_resources['ram_gb']} GB, "
        f"Storage: {cloud_resources['storage_gb']} GB, "
        f"Region: {cloud_resources['region']}"
    )


# 5. Deploy the virtual machine
deployment_status = deploy_vm()
print("\nDeployment Status:")
print(deployment_status)


# 6. Create a storage allocation function
def allocate_storage(size):
    """Simulate allocating cloud storage in gigabytes."""
    if (
        not isinstance(size, (int, float))
        or isinstance(size, bool)
        or size <= 0
    ):
        return "Error: Storage size must be a positive number."

    return f"Storage allocation successful: {size} GB allocated."


storage_status = allocate_storage(cloud_resources["storage_gb"])
print("\nStorage Status:")
print(storage_status)


# 7. Create an auto-scaling function
def auto_scale(load):
    """Decide whether to scale up, scale down, or maintain resources."""
    if (
        not isinstance(load, (int, float))
        or isinstance(load, bool)
        or not 0 <= load <= 100
    ):
        return "Invalid load: enter a number between 0 and 100."

    if load > 70:
        return "Scale up: increase cloud resources."
    elif load < 30:
        return "Scale down: reduce cloud resources."
    else:
        return "Maintain: keep current cloud resources."


print("\nAuto-Scaling Tests:")
print("Load 85%:", auto_scale(85))
print("Load 20%:", auto_scale(20))
print("Load 50%:", auto_scale(50))


# 8. Simulate a GET request to a public API
api_url = "https://jsonplaceholder.typicode.com/todos/1"

print("\nPublic API Request:")

try:
    response = requests.get(api_url, timeout=10)
    response.raise_for_status()

    api_data = response.json()

    print("API request successful.")
    print(json.dumps(api_data, indent=4))

except requests.exceptions.RequestException as error:
    print("API request failed:", error)


# 9. Build the cloud cost model
cpu_cost_per_core = 10
ram_cost_per_gb = 5
storage_cost_per_gb = 1

cpu_cost = cloud_resources["cpu_cores"] * cpu_cost_per_core
ram_cost = cloud_resources["ram_gb"] * ram_cost_per_gb
storage_cost = cloud_resources["storage_gb"] * storage_cost_per_gb

total_cost = cpu_cost + ram_cost + storage_cost

print("\nCloud Cost Breakdown:")
print(f"CPU Cost: ${cpu_cost:.2f}")
print(f"RAM Cost: ${ram_cost:.2f}")
print(f"Storage Cost: ${storage_cost:.2f}")
print(f"Total Estimated Cost: ${total_cost:.2f}")


# 10. Print the cloud deployment summary
print("\n" + "=" * 45)
print("CLOUD DEPLOYMENT SUMMARY")
print("=" * 45)
print(f"Service Model: {service_model}")
print(f"Deployment Status: {deployment_status}")
print(f"Storage Status: {storage_status}")
print(f"Estimated Total Cost: ${total_cost:.2f}")
print("=" * 45)


